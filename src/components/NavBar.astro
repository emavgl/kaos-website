---
interface Props { base: string }
const { base } = Astro.props;
---
<nav class="site-nav">
  <div class="container nav-inner">
    <a href={base} class="brand" aria-label="KAOS home">
      <img src={`${base}kaos-logo.svg`} alt="" class="brand-logo" width="38" height="38" />
      <span>KAOS</span>
    </a>
    <div class="nav-links">
      <a href={base}>Home</a>
      <a href={`${base}privacy-policy`}>Privacy</a>
      <a href={`${base}data-safety`} class="hide-sm">Data safety</a>
      <a href={`${base}content-rating`}>Content rating</a>
    </div>
  </div>
</nav>
