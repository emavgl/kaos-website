---
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'KAOS is a fast arcade survival game. Tilt your phone, dodge the chaos, and survive as long as you can.',
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Emanuele Viglianisi" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#101319" />
    <meta name="google-site-verification" content="xHNmUQ0glT1NYuoe0CHEpNi0BDaHZDal20dmfhNm-W8" />
    <link rel="icon" type="image/svg+xml" href={`${base}kaos-logo.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@500;700;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={`${base}styles.css`} />
    <title>{title}</title>
  </head>
  <body>
    <NavBar base={base} />
    <main><slot /></main>
    <Footer base={base} />
  </body>
</html>
